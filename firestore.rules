rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Admin Verification: checks if logged-in user is awcsrilanka@gmail.com
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'awcsrilanka@gmail.com' ||
        request.auth.token.admin == true
      );
    }

    // 1. Cruelty & Abuse Complaints:
    // Any citizen can submit (create-only) with mandatory fields.
    // Reading, updating, and managing complaints is strictly restricted to Admin.
    match /complaints/{ticketId} {
      allow create: if request.resource.data.keys().hasAll(['phone', 'email', 'details', 'token']);
      allow read, update, delete: if isAdmin();
    }

    // 2. Legal Assistance Requests:
    // Any citizen can submit (create-only) with mandatory fields.
    // Reading and updating is strictly restricted to Admin.
    match /legalRequests/{ticketId} {
      allow create: if request.resource.data.keys().hasAll(['phone', 'email', 'details', 'token']);
      allow read, update, delete: if isAdmin();
    }

    // 3. Master Cases & Legal Milestones (Public Projection):
    // Public can view/read verified case timelines.
    // Only Admin can create or update cases.
    match /cases/{caseId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 4. Ticket Status Lookup (Sanitized Citizen Tracking):
    // Public can read the status of their token without logging in.
    // Only Admin can update the tracking status.
    match /ticketStatus/{token} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 5. System Audit Logs & Volunteers (Admin Only)
    match /volunteers/{volunteerId} {
      allow create: if true; // Public can submit application
      allow read, update, delete: if isAdmin();
    }
  }
}
